# Raw source data -- copied in by hand, tracked by DVC if you ran `dvc add`.
data/raw

# MLflow. Deliberately NOT a DVC output (DVC deletes outputs before a stage
# runs, which would wipe experiment history), so it needs ignoring here.
# mlruns/ holds the pickled registry models and is usually the largest
# untracked thing in the repo.
training/mlflow.db
mlruns/

# Training artifacts. DVC writes its own .gitignore for stage outputs, but
# only after a stage has run at least once; these cover the gap.
training/checkpoints/
training/checkpoints_*/
training/optuna_study.db
deployment/exported_model/
data/interim/
data/processed/

# NOTE: metrics/ is intentionally absent. Those files are declared
# `cache: false` in dvc.yaml, which means git is meant to version them --
# that is what makes `dvc metrics diff` work across commits.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

